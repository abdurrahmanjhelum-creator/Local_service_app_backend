# Required on Vercel
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/local_services
JWT_SECRET=your_jwt_secret_here

# Optional — image uploads (required for profile photos on Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — OTP / password reset email
EMAIL_USER=
EMAIL_PASS=

# Optional — Firebase Cloud Messaging (JSON string of service account)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local only
PORT=5000
NODE_ENV=development
